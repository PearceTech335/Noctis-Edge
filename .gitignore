# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.venv/
venv/

# Large wordlists (not needed — program uses system SecLists)
WordLists/rockyou.txt

# CVE Knowledge Base — machine-specific accumulated data (legacy single-file format)
cve_knowledge_base.json

# Nuclei KB (same pattern — runtime accumulated data, not source)
nuclei_kb.json

# CVE database (57 MB CSV — regenerate with CVE/cve-offline/updatecsv.sh)
CVE/cve-offline/cve-summary.csv

# Embedded git repos — cloned at runtime by setup.sh, not tracked
CVE/cve/
CVE/cve-offline/

# NVD incremental download cache — large intermediate JSON files
CVE/.nvd-cache/

# Offline threat-intelligence databases — rebuilt by setup.sh / update.sh, not source
CVE/epss-scores.csv
CVE/nvd-cvss.csv
CVE/cwe-data.csv
CVE/kev-catalog.csv

# safe_nse_scripts.json is the free-tier mapping — committed to the public repo
# (aggressive_nse_scripts.json and unsafe_nse_scripts.json are inside Noctis-Edge-KB/ above)

# Development / quarantine scratch area — not for distribution
quarantine/

# Backup files created by editors and ad-hoc scripts
*.bak
fix_funcs.py

# Scan log and build log artefacts — generated during development/testing
_scan_*.log
build.log
build_full.log

# Copilot instruction backup files
COPILOT_INSTRUCTIONS.md.bak


# Scan session data (runtime output — not source code)
sessions/
session.json

# Nikto scan output files (nikto/ directory is the bundled submodule — do NOT ignore it)
nikto_*.txt

# Database files
reconotron.db

# Per-user configuration — contains installation UUID and license key
# Generated automatically by setup.sh / docker-entrypoint.sh
noctis.conf

# Noctis-Edge-KB — all subscriber/community KB assets live here.
# Contents are populated by update.sh (Cloudflare relay) and written by noctis.py at runtime.
# Never committed — includes CVE probes, tool KB, tool manifest, NSE script mappings.
Noctis-Edge-KB/

# Internal development notes — not for public distribution
improvements/

# Log files
*.log
*.db
*.sqlite

# Noctis Edge local config — may contain git tokens; never commit
.noctis_config

# Tool manifest backup — created when update.sh overwrites with a new subscriber download
tool_manifest.json.bak
ForYouToDo.md
.codex
.noctis_config.example
cloudflare/PAID_TIER_PLAN.md
generate_kb_scripts.py

# Subscriber-only / operator tool manifest scripts — delivered via paid update channel
scripts/build_tool_manifest.py
scripts/add_tool_manifest.py
scripts/submit_tool_manifest.py

# Subscriber-only / operator nuclei KB scripts — delivered via paid update channel
scripts/merge_nuclei_kb.py

# Internal development / scratch directories — not for distribution
improvements/

# VS Code Copilot agent instructions — root-level variant (also .github/instructions/)
COPILOT_INSTRUCTIONS.md

# Test server (simulates vulnerable host for local testing — not part of the project)
test-webserver/

# IDE / tool config
.continue/
.idea/
.vscode/

# VS Code Copilot agent instructions — local editor configuration, not part of the project
.github/instructions/

# OS noise
.DS_Store
Thumbs.db
*.swp
*.swo
